# Local development defaults — no Docker or external services required.
DATABASE_URL=sqlite+aiosqlite:///./sdr.db
# Production/local PostgreSQL example (use a secret manager or IAM-generated token):
# DATABASE_URL=postgresql+asyncpg://<db-user>:<password-or-iam-token>@<rds-host>:5432/<database>?ssl=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=local-keyword
VECTOR_STORE=simple
DEMO_MODE=true
GLOBAL_KILL_SWITCH=false
# Approved email drafts are always redirected to this mailbox in the demo.
APPROVAL_DELIVERY_EMAIL=ch24b007@smail.iitm.ac.in
# Optional live SMTP transport. Leave SMTP_HOST blank to retain audited demo delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# DronaHQ agent webhooks (each URL/key pair is required only for its stage).
# URLs are deployment values; API keys are secrets.

# DronaHQ agent registry — each URL, key, and ID is required only when that
# external stage is enabled. Keys are secrets; URLs are deployment values.
DRONAHQ_TIMEOUT_SECONDS=30
